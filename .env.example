# ============================================================================
# Ship24X7 Platform - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit .env file to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# ENVIRONMENT
# ----------------------------------------------------------------------------
# Options: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Development

# ----------------------------------------------------------------------------
# DATABASE (SQL Server)
# ----------------------------------------------------------------------------
# SQL Server SA password (must meet complexity requirements)
# Requirements: At least 8 characters, uppercase, lowercase, digit, special char
SQL_SA_PASSWORD=StrongPass@123
MSSQL_PID=Express

# ----------------------------------------------------------------------------
# MESSAGE BROKER (RabbitMQ)
# ----------------------------------------------------------------------------
RABBITMQ_USER=ship24x7
RABBITMQ_PASSWORD=Ship24X7@RabbitPass

# ----------------------------------------------------------------------------
# JWT AUTHENTICATION
# ----------------------------------------------------------------------------
# JWT secret key for token signing (minimum 32 characters)
# Generate using: openssl rand -base64 32
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars-change-this-in-production
JWT_ISSUER=Ship24X7
JWT_AUDIENCE=Ship24X7API

# ----------------------------------------------------------------------------
# GOOGLE OAUTH 2.0
# ----------------------------------------------------------------------------
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/callback

# ----------------------------------------------------------------------------
# EMAIL (SMTP)
# ----------------------------------------------------------------------------
# SMTP server configuration for sending emails
# Examples:
#   Gmail: smtp.gmail.com (port 587)
#   SendGrid: smtp.sendgrid.net (port 587)
#   Mailgun: smtp.mailgun.org (port 587)
#   AWS SES: email-smtp.us-east-1.amazonaws.com (port 587)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@ship24x7.com
SMTP_FROM_NAME=Ship24X7
SMTP_ENABLE_SSL=true

# ----------------------------------------------------------------------------
# SMS (Twilio)
# ----------------------------------------------------------------------------
# Get credentials from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
SMS_PROVIDER=Twilio

# ----------------------------------------------------------------------------
# PAYMENTS (Razorpay)
# ----------------------------------------------------------------------------
# Get credentials from: https://dashboard.razorpay.com/
# Use test credentials (rzp_test_*) for development
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_CURRENCY=INR

# ----------------------------------------------------------------------------
# FILE STORAGE
# ----------------------------------------------------------------------------
# Options: Local, AzureBlob
STORAGE_TYPE=Local

# Azure Blob Storage (optional - uncomment if using)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccountname;AccountKey=youraccountkey;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER=ship24x7-documents

# ----------------------------------------------------------------------------
# HTTPS CERTIFICATE
# ----------------------------------------------------------------------------
# Certificate password for HTTPS (API Gateway)
# Generate using: dotnet dev-certs https -ep ./certs/aspnetapp.pfx -p YourPassword
CERT_PASSWORD=Ship24X7@Cert

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
# Allowed origins (comma-separated for multiple)
# Development: http://localhost:4200
# Production: https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://localhost:4200

# ----------------------------------------------------------------------------
# API GATEWAY
# ----------------------------------------------------------------------------
# API Gateway URL for frontend
# Development: http://localhost:8000
# Production: https://api.yourdomain.com
API_GATEWAY_URL=http://localhost:8000

# ============================================================================
# PRODUCTION CHECKLIST
# ============================================================================
#
# Before deploying to production:
#
# 1. ASPNETCORE_ENVIRONMENT=Production
# 2. Generate strong JWT_SECRET_KEY: openssl rand -base64 32
# 3. Use strong SQL_SA_PASSWORD (min 8 chars, mixed case, numbers, symbols)
# 4. Switch Razorpay from test (rzp_test_*) to live (rzp_live_*) credentials
# 5. Use production SMTP service (SendGrid, AWS SES, Mailgun)
# 6. Use production Twilio account
# 7. Update GOOGLE_REDIRECT_URI to production domain
# 8. Use proper SSL/TLS certificates (Let's Encrypt or commercial)
# 9. Restrict CORS_ALLOWED_ORIGINS to production domain only (HTTPS)
# 10. Consider Azure Blob Storage or AWS S3 instead of local storage
#
# ============================================================================
# SECURITY BEST PRACTICES
# ============================================================================
#
# ✓ Never commit .env to version control (already in .gitignore)
# ✓ Rotate secrets every 90 days (JWT, passwords, API keys)
# ✓ Use different secrets for dev/staging/production
# ✓ Use secret management services in production:
#   - Azure Key Vault
#   - AWS Secrets Manager
#   - HashiCorp Vault
# ✓ Monitor for leaked secrets (GitGuardian, TruffleHog)
# ✓ Limit access to secrets (role-based access control)
#
# ============================================================================
# QUICK START
# ============================================================================
#
# For development with dummy credentials (no real services needed):
#
#   ./scripts/start.sh --dev
#
# This will use dummy values for OAuth, Email, SMS, and Payments.
# Only database and RabbitMQ need to be running.
#
# ============================================================================
